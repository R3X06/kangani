# Copy this file to .env and fill in real values. Never commit .env itself.

# Telegram bot token, from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Anthropic API key, from https://console.anthropic.com/settings/keys
# Make sure the workspace it belongs to has an active payment method --
# a key can look completely valid and still fail auth silently otherwise.
ANTHROPIC_API_KEY=

# IANA timezone name used for all local-time display and scheduling
TIMEZONE=Asia/Singapore

# Where the SQLite database file lives. Locally you can leave this unset -- it
# defaults to ./kangani.db next to the code. In a container/Railway deploy,
# point it at a file on a MOUNTED VOLUME (e.g. /data/kangani.db) so your data
# survives redeploys. The parent directory is created automatically at startup.
# DB_PATH=/data/kangani.db